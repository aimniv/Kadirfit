# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (no trailing slash).
# Used to build the links inside verification / password-reset e-mails.
# AI Studio injects this automatically. Locally it defaults to http://localhost:3000.
APP_URL="http://localhost:3000"

# DATABASE: PostgreSQL connection string (Neon / Supabase). REQUIRED in production.
# Use the POOLED connection string on Vercel (Neon: host contains "-pooler"; Supabase: transaction pooler).
# Leave unset locally to store accounts in ./data/auth.json instead.
DATABASE_URL="postgresql://user:password@ep-sample-123-pooler.eu-central-1.neon.tech/kadirfit?sslmode=require"
# DATABASE_SSL="no-verify"   # only if you get "self-signed certificate" errors (some Supabase poolers)

# AUTH: signs session cookies. REQUIRED in production, 32+ random characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="your-super-secret-jwt-key-32-chars-minimum"
# Local JSON store location (only used when DATABASE_URL is not set).
# DATA_DIR="./data"
# First super admin for production (created once if the e-mail doesn't exist yet).
# ADMIN_EMAIL="admin@kadirfit.com"
# ADMIN_PASSWORD="change-me-Str0ng!"
# Demo accounts (admin@kadirfit.com / kullanici@kadirfit.com) are seeded automatically
# outside production. Set to "true" to force them on, "false" to force them off.
# SEED_DEMO_USERS="false"

# MAIL (SMTP): sends the e-mail verification and password-reset links.
# Without SMTP_HOST the links are printed to the server console in development.
# In production, e-mails will NOT be delivered until this is configured.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"        # true for port 465
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
MAIL_FROM="Kadirfit <no-reply@kadirfit.com>"

# ORDERS & PAYMENTS
# Bank details shown to customers who choose Havale / EFT, separated by ";". Leave empty to hide that option.
# Use YOUR real account details, e.g.  BANK_TRANSFER_DETAILS="Garanti BBVA - TR00 0000 ... - Firma Adi; Ziraat - TR00 ... - Firma Adi"
BANK_TRANSFER_DETAILS=""
# Where to e-mail a heads-up for every new order (optional).
ORDER_NOTIFY_EMAIL=""
# Card payments are NOT active: they need an iyzico / PayTR merchant account and its API keys.

# OAuth (not wired up yet)
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# PAYMENTS: iyzico / PayTR API Credentials
IYZICO_API_KEY="sandbox-iyzico-api-key"
IYZICO_SECRET_KEY="sandbox-iyzico-secret-key"
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
PAYTR_MERCHANT_ID="your-paytr-merchant-id"
PAYTR_MERCHANT_KEY="your-paytr-merchant-key"
PAYTR_MERCHANT_SALT="your-paytr-merchant-salt"

# STORAGE: Cloudinary or S3 compatible object storage
CLOUDINARY_CLOUD_NAME="kadirfit-media"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
